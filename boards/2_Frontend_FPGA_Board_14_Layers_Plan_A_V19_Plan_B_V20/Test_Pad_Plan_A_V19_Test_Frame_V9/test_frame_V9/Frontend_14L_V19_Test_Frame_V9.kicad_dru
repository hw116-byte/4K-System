(version 1)

# V8 JLC working rules, from JLC HDI FAQ updated 26 Oct 2026 and capabilities page. Provisional until JLC stack review.
# Actual BGA/DF40 trial copper is allowed; no whole-board or fabrication release.
# LANE TRIAL (10 Nov 2026): layer roles, 12 layers: S/G/P/P/G/S/G/S/G/S/G/S; L1 F.Cu, L12 B.Cu. Laser F-In1, In1-In2, In2-In3, In8-In9, In9-In10, In10-B; buried In3-In8.
# (was V42, 8 layers: S/G/S/P/P/S/G/S; laser F-In1, In1-In2, In5-In6, In6-B; buried In2-In5.)
# Trial stack: JLCPCB 12-layer 3-step JLCH121611Y3-1078A, 1.53 mm, NOT confirmed by JLC (3-high stacked laser vias, laser on buried, via in pad are assumptions).
# Before: JLCPCB 8-layer 2-step stack JLCH081611Y2-1078A, 1.52 mm (V42; was 10-layer JLCH101611Y2-2313 to V41); 1 oz inner copper; exact stack, plating, filled/capped interfaces,
# registration, finished-hole definitions and impedance profiles are UNISSUED.
# https://jlcpcb.com/help/article/hdi-pcb-capabilities-faq
# https://docs.kicad.org/10.0/en/pcbnew/pcbnew.html#custom-design-rules
# KiCad resolves each constraint from the last matching rule. Keep guards last.
# Board min/default microvia drill must separately be 0.150 mm in .kicad_pro.
# Track and clearance floor 0.090 mm (3.5 mil, JLC preferred). 3 mil only by explicit local rule.

# Package copper is preserved. These rules distinguish same-component land gaps
# from the existing 0.20 mm Default routing clearance. No DRC exclusions added.
# U8 is now TI RSV0016A; current copper is preserved. This is a pad/pad minimum only.
# U11 is now Nexperia SOT886; no inherited-device launch rationale is reused.
(rule "U8 current RSV pad-to-pad inherited clearance"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U8') && B.memberOfFootprint('U8')")
 (constraint clearance (min 0.15mm)))
(rule "U11 current SOT886 pad-to-pad inherited clearance"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U11') && B.memberOfFootprint('U11')")
 (constraint clearance (min 0.17mm)))
(rule "U12 DSE manufacturer land spacing"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U12') && B.memberOfFootprint('U12')")
 (constraint clearance (min 0.15mm)))
(rule "R44 0201 metric manufacturer land spacing"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('R44') && B.memberOfFootprint('R44')")
 (constraint clearance (min 0.18mm)))
# Molex 46765 signal lands: .40 mm pitch minus .25 mm copper = .15 mm.
(rule "J3 Molex manufacturer land spacing"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J3') && B.memberOfFootprint('J3')")
 (constraint clearance (min 0.15mm)))
# L1/L2 now use exact TDK .30 mm land gap; no ferrite clearance exception.

# Fine escape uses KiCad courtyard-intersection semantics. Split track segments
# at the U1 courtyard boundary: a crossing segment is selected as a whole.
# General routing remains .20/.20; inspect the escape extent during routing.
# No different-net SMD pad/pad gap is relaxed by this rule.
# Zone and other object types are excluded; inner copper is handled below.
(rule "U1 local BGA escape"
 (layer outer)
 (condition "(A.Type == 'Pad' || A.Type == 'Track' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Track' || B.Type == 'Via') && (A.Type != 'Pad' || B.Type != 'Pad') && A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')")
 (constraint clearance (min 0.09mm)))
(rule "U1 local neckdown width"
 (condition "A.Type == 'Track' && A.intersectsCourtyard('U1')")
 (constraint track_width (min 0.09mm) (opt 0.09mm)))

# J3 shell supports are plated COMPONENT slots, not via drills.
# Published component-hole requirements remain separate from global via rules.
(rule "J3 component hole to inner copper"
 (layer inner)
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.memberOfFootprint('J3')")
 (constraint hole_clearance (min 0.30mm)))
(rule "J3 component hole to outer track"
 (layer outer)
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.memberOfFootprint('J3') && B.Type == 'Track'")
 (constraint hole_clearance (min 0.35mm)))
(rule "Component plated hole separation"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
 (constraint hole_to_hole (min 0.45mm)))

# These exposed conductors require solid plane connections when zones are added.
(rule "TPS748 thermal ground connection"
 (condition "A.Type == 'Pad' && (A.memberOfFootprint('U5') || A.memberOfFootprint('U6')) && A.Pad_Number == '11'")
 (constraint zone_connection solid))


# Width floor .10 is available for other fine-pitch pad neckdowns too.
# Default preferred routing width/clearance remains .20/.20. The U1 escape and exact inner HDI
# rules relax only their named copper checks, with whole-object selection.
(rule "Through via conservative annulus"
 (condition "A.Type == 'Via' && A.Via_Type == 'Through'")
 (constraint annular_width (min 0.10mm)))
(rule "Component plated hole annulus"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint annular_width (min 0.15mm)))
# U8 has no broad fine Pad/Track clearance waiver. Its existing pad/pad
# manufacturer exception remains above. A future bounded launch needs an
# explicit, reviewed rule area and native validation; do not relax its courtyard.
# No blanket same-net hole-overlap or physical drill-spacing waiver is added.

# Every exact HDI family retains its physical capture lands. 0.090 mm foreign Via/Via copper clearance on shared inner layers.
(rule "Conditional exact HDI inner via capture clearance"
 (layer inner)
 (condition "((A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'F.Cu' && A.Layer_Bottom == 'In1.Cu') || (A.Layer_Top == 'In1.Cu' && A.Layer_Bottom == 'In2.Cu') || (A.Layer_Top == 'In2.Cu' && A.Layer_Bottom == 'In3.Cu') || (A.Layer_Top == 'In10.Cu' && A.Layer_Bottom == 'In11.Cu') || (A.Layer_Top == 'In11.Cu' && A.Layer_Bottom == 'In12.Cu') || (A.Layer_Top == 'In12.Cu' && A.Layer_Bottom == 'B.Cu'))) || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')) && ((B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'F.Cu' && B.Layer_Bottom == 'In1.Cu') || (B.Layer_Top == 'In1.Cu' && B.Layer_Bottom == 'In2.Cu') || (B.Layer_Top == 'In2.Cu' && B.Layer_Bottom == 'In3.Cu') || (B.Layer_Top == 'In10.Cu' && B.Layer_Bottom == 'In11.Cu') || (B.Layer_Top == 'In11.Cu' && B.Layer_Bottom == 'In12.Cu') || (B.Layer_Top == 'In12.Cu' && B.Layer_Bottom == 'B.Cu'))) || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.09mm)))

# Lane layers L6, L8 (inside the buried span): tracks and buried lands only.
(rule "Conditional HDI L8 exact-family track and via copper clearance"
 (layer In7.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.09mm)))
(rule "Conditional HDI L10 exact-family track and via copper clearance"
 (layer In9.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.09mm)))

# Lane layer L10: tracks and the L9-L10 / L10-L11 laser lands only.
(rule "Conditional HDI L12 exact-family track and via copper clearance"
 (layer In11.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'In10.Cu' && A.Layer_Bottom == 'In11.Cu') || (A.Layer_Top == 'In11.Cu' && A.Layer_Bottom == 'In12.Cu')))) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'In10.Cu' && B.Layer_Bottom == 'In11.Cu') || (B.Layer_Top == 'In11.Cu' && B.Layer_Bottom == 'In12.Cu'))))")
 (constraint clearance (min 0.09mm)))

# Power B L4 (mixed, as old L5): tracks, buried lands and the L3-L4 laser lands only.
(rule "Conditional HDI L4 mixed-power exact-family track and via copper clearance"
 (layer In3.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu') || (A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'In2.Cu' && A.Layer_Bottom == 'In3.Cu')))) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu') || (B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'In2.Cu' && B.Layer_Bottom == 'In3.Cu'))))")
 (constraint clearance (min 0.09mm)))

# Baseline plane copper clearance; existing component-hole guards stay intact.
(rule "Shared GND plane clearance"
 (condition "(A.Type == 'Zone' && A.NetName == 'GND') || (B.Type == 'Zone' && B.NetName == 'GND')")
 (constraint clearance (min 0.20mm)))
# Reference profile: every GND plane keeps 0.200 mm to the HDI families that cross it (L2: laser 1-2, 2-3; L5, L7: buried 4-9;
# L9: buried 4-9 and laser 9-10; L11: laser 10-11, 11-12). Hole-to-foreign-Cu stays 0.200 mm globally.
(rule "GND L2 reference to exact HDI family, hole-based (0.125 mm from the land = 0.20 mm hole to copper; was 0.20 mm until 10 Nov 2026)"
 (layer In1.Cu)
 (condition "(A.Type == 'Zone' && A.NetName == 'GND' && (B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'F.Cu' && B.Layer_Bottom == 'In1.Cu') || (B.Layer_Top == 'In1.Cu' && B.Layer_Bottom == 'In2.Cu')))) || (B.Type == 'Zone' && B.NetName == 'GND' && (A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'F.Cu' && A.Layer_Bottom == 'In1.Cu') || (A.Layer_Top == 'In1.Cu' && A.Layer_Bottom == 'In2.Cu'))))")
 (constraint clearance (min 0.125mm)))
(rule "GND L7 reference to exact HDI family, hole-based (0.125 mm from the land = 0.20 mm hole to copper; was 0.20 mm until 10 Nov 2026)"
 (layer In6.Cu)
 (condition "(A.Type == 'Zone' && A.NetName == 'GND' && (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu')) || (B.Type == 'Zone' && B.NetName == 'GND' && (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.125mm)))
(rule "GND L9 reference to exact HDI family, hole-based (0.125 mm from the land = 0.20 mm hole to copper; was 0.20 mm until 10 Nov 2026)"
 (layer In8.Cu)
 (condition "(A.Type == 'Zone' && A.NetName == 'GND' && (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu')) || (B.Type == 'Zone' && B.NetName == 'GND' && (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.125mm)))
(rule "GND L11 reference to exact HDI family, hole-based (0.125 mm from the land = 0.20 mm hole to copper; was 0.20 mm until 10 Nov 2026)"
 (layer In10.Cu)
 (condition "(A.Type == 'Zone' && A.NetName == 'GND' && ((B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu') || (B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'In10.Cu' && B.Layer_Bottom == 'In11.Cu'))))) || (B.Type == 'Zone' && B.NetName == 'GND' && ((A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu') || (A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'In10.Cu' && A.Layer_Bottom == 'In11.Cu')))))")
 (constraint clearance (min 0.125mm)))
(rule "GND L13 reference to exact HDI family, hole-based (0.125 mm from the land = 0.20 mm hole to copper; was 0.20 mm until 10 Nov 2026)"
 (layer In12.Cu)
 (condition "(A.Type == 'Zone' && A.NetName == 'GND' && (B.Type == 'Via' && B.Via_Type == 'Micro' && ((B.Layer_Top == 'In11.Cu' && B.Layer_Bottom == 'In12.Cu') || (B.Layer_Top == 'In12.Cu' && B.Layer_Bottom == 'B.Cu')))) || (B.Type == 'Zone' && B.NetName == 'GND' && (A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'In11.Cu' && A.Layer_Bottom == 'In12.Cu') || (A.Layer_Top == 'In12.Cu' && A.Layer_Bottom == 'B.Cu'))))")
 (constraint clearance (min 0.125mm)))

# Exact adjacent laser stages, not a skip-via permission (0.075 mm ring is the published minimum).
(rule "JLC laser via 0.25-0.10"
 (condition "(A.Type == 'Via' && A.Via_Type == 'Micro' && ((A.Layer_Top == 'F.Cu' && A.Layer_Bottom == 'In1.Cu') || (A.Layer_Top == 'In1.Cu' && A.Layer_Bottom == 'In2.Cu') || (A.Layer_Top == 'In2.Cu' && A.Layer_Bottom == 'In3.Cu') || (A.Layer_Top == 'In10.Cu' && A.Layer_Bottom == 'In11.Cu') || (A.Layer_Top == 'In11.Cu' && A.Layer_Bottom == 'In12.Cu') || (A.Layer_Top == 'In12.Cu' && A.Layer_Bottom == 'B.Cu')))")
 (constraint hole_size (min 0.10mm) (opt 0.10mm) (max 0.15mm))
 (constraint via_diameter (min 0.25mm) (opt 0.25mm))
 (constraint annular_width (min 0.075mm)))
# The buried via is the mechanically drilled six-layer core L4 through L9, retaining all intermediate lands.
(rule "JLC buried via 0.30-0.15"
 (condition "(A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')")
 (constraint hole_size (min 0.15mm))
 (constraint via_diameter (min 0.30mm))
 (constraint annular_width (min 0.075mm)))

# JLC HDI table: via hole edge to trace edge at least 0.15 mm.
(rule "JLC via hole to trace"
 (condition "A.Type == 'Via' && (A.Via_Type == 'Micro' || A.Via_Type == 'Buried') && B.Type == 'Track'")
 (constraint hole_clearance (min 0.15mm)))
# JLC HDI table: blind via hole edge to via hole edge, same net at least 0.13 mm. Different net uses the 0.24 mm board rule.
(rule "JLC same-net via hole spacing"
 (condition "A.Type == 'Via' && B.Type == 'Via' && A.NetName == B.NetName")
 (constraint hole_to_hole (min 0.13mm)))
# V50: absolute-coordinate J3 GND VIPPO exception retired after connector relocation.
# No replacement J3 via reservation or fine via/pad clearance is approved.
# V58 retires the stale U10 absolute-coordinate neck exceptions.
# No U10 launch is routed by this BGA/DF40 study.

# FINAL GUARD: power L3/L4 have no fine Zone/Via allowance (was L4/L5 in the 8-layer stack).
# Leave this after every clearance exception. Hole-to-foreign-Cu remains 0.200 mm.
(rule "L3 L4 power zone to via, V12 JLC hole-based 0.2 mm hole-to-copper"
 (condition "(A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu') && ((A.Type == 'Zone' && A.NetName != 'GND' && B.Type == 'Via') || (B.Type == 'Zone' && B.NetName != 'GND' && A.Type == 'Via'))")
 (constraint clearance (min 0.125mm)))

# Plane ownership guards: no routed tracks on the GND planes L2, L5, L7, L9, L11 or on power A L3 (was In1/In3/In6 in 8 layers).
# Power B L4 allows slow-net tracks only (rule below, was the L5 rule).
# L2: slow local nets (JTAG, boot control, boot SPI, local support) may run here as tracks in the ground pour. Howard, 10 Nov 2026:
# "can u use one or two of our current GND layers? we have so many gnd layers". Every other net class stays forbidden.
(rule "8L V3 L2 ground layer carries slow local nets only"
 (layer In1.Cu)
 (condition "A.Type == 'Track' && A.NetClass != 'JTAG_1V8' && A.NetClass != 'Boot_Control' && A.NetClass != 'Boot_SPI_x1' && A.NetClass != 'Local_Support'")
 (constraint disallow track))
(rule "V58 no tracks on In2.Cu reference or power plane"
 (layer In2.Cu)
 (constraint disallow track))
(rule "V58 no tracks on In6.Cu reference or power plane"
 (layer In6.Cu)
 (constraint disallow track))
(rule "V58 no tracks on In8.Cu reference or power plane"
 (layer In8.Cu)
 (constraint disallow track))
(rule "V58 no tracks on In10.Cu reference or power plane"
 (layer In10.Cu)
 (constraint disallow track))
# L11: slow local nets (JTAG, boot control, boot SPI, local support) may run here as tracks in the ground pour. Howard, 10 Nov 2026:
# "can u use one or two of our current GND layers? we have so many gnd layers". Every other net class stays forbidden.
(rule "8L V3 L13 ground layer carries slow local nets only"
 (layer In12.Cu)
 (condition "A.Type == 'Track' && A.NetClass != 'JTAG_1V8' && A.NetClass != 'Boot_Control' && A.NetClass != 'Boot_SPI_x1' && A.NetClass != 'Local_Support'")
 (constraint disallow track))

# V24 / channel plan S1 (Howard, 3 Nov 2026: "Use recommendations"): per-group skew budget, on-board skew <= 0.5 ns,
# no serpentines. Written as length with the provisional inner-layer 6.9 ps/mm (0.5 ns -> 72 mm) until JLC accepts the
# stack and tuning profiles exist. Each rule compares only the 11 lanes of one ASIC receive group (GT rules: budget each
# group separately; do not match independent lanes). Qualify later against the ASIC output-valid window.
(rule "ASIC1 receive group skew"
 (condition "A.NetName == '/ASIC1_*'")
 (constraint skew (max 72mm)))
(rule "ASIC2 receive group skew"
 (condition "A.NetName == '/ASIC2_*'")
 (constraint skew (max 72mm)))
(rule "ASIC3 receive group skew"
 (condition "A.NetName == '/ASIC3_*'")
 (constraint skew (max 72mm)))
(rule "ASIC4 receive group skew"
 (condition "A.NetName == '/ASIC4_*'")
 (constraint skew (max 72mm)))
(rule "ASIC5 receive group skew"
 (condition "A.NetName == '/ASIC5_*'")
 (constraint skew (max 72mm)))
(rule "ASIC6 receive group skew"
 (condition "A.NetName == '/ASIC6_*'")
 (constraint skew (max 72mm)))
(rule "ASIC7 receive group skew"
 (condition "A.NetName == '/ASIC7_*'")
 (constraint skew (max 72mm)))
(rule "ASIC8 receive group skew"
 (condition "A.NetName == '/ASIC8_*'")
 (constraint skew (max 72mm)))

# Lane trial (12-layer JLCH121611Y3-1078A; was V42 8-layer): routing-layer rules for differential pairs. Provisional FEM widths; confirm in JLC's calculator.
(rule "V42 GT and 125 MHz reference clock pairs on L1/L14 only"
 (layer inner)
 (condition "A.Type == 'Track' && (A.NetClass == 'GTP_Data' || A.NetClass == 'Clock_125MHz')")
 (constraint disallow track))
(rule "V42 L4 power layer carries slow nets only"
 (layer In3.Cu)
 (condition "A.Type == 'Track' && A.NetClass != 'JTAG_1V8' && A.NetClass != 'Boot_Control' && A.NetClass != 'Boot_SPI_x1' && A.NetClass != 'Local_Support' && A.NetClass != 'Default' && A.NetClass != 'Power_Return'")
 (constraint disallow track))
# 11 Nov 2026 (Howard: "can u fix all these issues?"): width 0.09 -> 0.08 mm on the 14-layer stack. Field solve: about 90 ohm on L8 and
# 93 ohm on L10 (was 85 / 88). 100 ohm needs 0.15 mm cores beside L8 and L10 (JLC custom stack) - not confirmed.
(rule "V42 LVDS cable pairs on inner layers (14-layer: about 90 to 93 ohm)"
 (layer inner)
 (condition "A.NetClass == 'LVDS_Cable'")
 (constraint track_width (min 0.08mm) (opt 0.08mm))
 (constraint diff_pair_gap (min 0.30mm) (opt 0.30mm)))

# ---- 14-layer build (Howard, 10 Nov 2026: "Add two layers"). All layer names above were shifted: old In4..In10 are now In6..In12,
# the buried via is In3.Cu to In10.Cu (L4-L11), and rule names carry the new L numbers. New layers L5 = In4.Cu and L6 = In5.Cu
# carry the slow local nets only (JTAG, boot control, boot SPI, local support); they sit between power B (L4) and ground (L7).
(rule "14L new signal layer L5 carries slow local nets only"
 (layer In4.Cu)
 (condition "A.Type == 'Track' && A.NetClass != 'JTAG_1V8' && A.NetClass != 'Boot_Control' && A.NetClass != 'Boot_SPI_x1' && A.NetClass != 'Local_Support'")
 (constraint disallow track))
(rule "14L new signal layer L6 carries slow local nets only"
 (layer In5.Cu)
 (condition "A.Type == 'Track' && A.NetClass != 'JTAG_1V8' && A.NetClass != 'Boot_Control' && A.NetClass != 'Boot_SPI_x1' && A.NetClass != 'Local_Support'")
 (constraint disallow track))
(rule "14L L5 track and buried-via copper clearance"
 (layer In4.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.09mm)))
(rule "14L L6 track and buried-via copper clearance"
 (layer In5.Cu)
 (condition "(A.Type == 'Track' || (A.Type == 'Via' && A.Via_Type == 'Buried' && A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu')) && (B.Type == 'Track' || (B.Type == 'Via' && B.Via_Type == 'Buried' && B.Layer_Top == 'In3.Cu' && B.Layer_Bottom == 'In10.Cu'))")
 (constraint clearance (min 0.09mm)))

# ---- 11 Nov 2026 review fixes (Howard: "can u fix all these issues?").
# Hops on the ground layers L2 and L13: the ground pour closes to 0.10 mm from the hop track (was the 0.20 mm net-class value),
# so each slot is about 0.29 mm wide instead of 0.49 mm. JLC spacing limit is 0.076 mm.
(rule "14L ground pour to hop track on L2"
 (layer In1.Cu)
 (condition "A.Type == 'Zone' && B.Type == 'Track'")
 (constraint clearance (min 0.10mm)))
(rule "14L ground pour to hop track on L13"
 (layer In12.Cu)
 (condition "A.Type == 'Zone' && B.Type == 'Track'")
 (constraint clearance (min 0.10mm)))
# Only the via spans of JLC template JLCH141611Y3-1078 may exist: laser 1-2, 2-3, 3-4, 11-12, 12-13, 13-14 and buried 4-11.
(rule "14L only the JLC via spans"
 (condition "A.Type == 'Via' && !((A.Layer_Top == 'F.Cu' && A.Layer_Bottom == 'In1.Cu') || (A.Layer_Top == 'In1.Cu' && A.Layer_Bottom == 'In2.Cu') || (A.Layer_Top == 'In2.Cu' && A.Layer_Bottom == 'In3.Cu') || (A.Layer_Top == 'In3.Cu' && A.Layer_Bottom == 'In10.Cu') || (A.Layer_Top == 'In10.Cu' && A.Layer_Bottom == 'In11.Cu') || (A.Layer_Top == 'In11.Cu' && A.Layer_Bottom == 'In12.Cu') || (A.Layer_Top == 'In12.Cu' && A.Layer_Bottom == 'B.Cu'))")
 (constraint disallow via))

# ---- 14 layers V11 test-frame edge exits (Howard, 18 Nov 2026: break-off test frame after the ONIX NRIC1384 test-board photo).
# 9 tracks run from existing pads to the board edge so the test-frame header can reach them; each breaks off with its tab.
# This is the only edge exception: tracks only, and only inside the three named rule areas (0.45 mm deep strips at the edge,
# south on L1, west and east on L14). Every other item keeps the 0.50 mm board copper-to-edge clearance. No DRC exclusions.
(rule "V11 test-frame edge exits"
 (condition "A.Type == 'Track' && (A.intersectsArea('V11 test-frame exit south') || A.intersectsArea('V11 test-frame exit west') || A.intersectsArea('V11 test-frame exit east'))")
 (constraint edge_clearance (min 0mm)))

# ---- Test frame V1 to V4, V7 and V9 (frame file only; V2, V3 and V4 changed silkscreen text only; V7 carries board 14 layers V17; V9 = V7 with the printed version text for board V19): the snap-off tab holes keep at least 0.20 mm from any copper (design 0.21 mm).
(rule "Test frame mouse-bite hole to copper"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.memberOfFootprint('MB*')")
 (constraint hole_clearance (min 0.2mm)))
