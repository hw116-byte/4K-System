	(text "Source / changes: Codex circuit using TI TS3A27518E Rev F Fig.5-2, Table 8-1:\nhttps://www.ti.com/lit/ds/symlink/ts3a27518e.pdf\nIN1/IN2 high select NO; active-low EN from rotary; 10k pullup.\nChannels (Howard 1 Nov 2026, for straight PCB routing):\nTCK=4, TDI=6, TMS=3, TDO=5, VREF=2; channel 1 unused.\nNO2-NO6: ±6 kV IEC contact rating; not a 5 V DC clamp.\nSelection, leakage, power-off and SI need checks." (exclude_from_sim no) (at 734.84 1011.73 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "b4989fe4-9a72-4e21-b159-92f1251f0367"))
	(text "Source / changes: Codex circuit using TI TS3A27518E Rev F Fig.5-2, Table 8-1:\nhttps://www.ti.com/lit/ds/symlink/ts3a27518e.pdf\nIN1/IN2 high select NO; active-low EN from rotary; 10k pullup.\nChannels (Howard 1 Nov 2026, for straight PCB routing):\nTCK=4, TDI=6, TMS=3, TDO=5, VREF=2; channel 1 unused.\nNO2-NO6: ±6 kV IEC contact rating; not a 5 V DC clamp.\nSelection, leakage, power-off and SI need checks." (exclude_from_sim no) (at 449.09 1011.185 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "bf29933b-2a0b-4a87-bf34-b8626bf14528"))
	
	
	
	
	(text "Function: HDMI7 selects shared JTAG and VREF.\n100R series parts alone do not provide 5 V protection." (exclude_from_sim no) (at 734.84 1007.23 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "e4324e34-233c-4abf-ad63-2d91075f53a6"))
	(text "HDMI EXTENSION BOARD - XEM8310 CONNECTIONS, POWER AND MOUNTING"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e9251bb3-aa9e-483a-a506-47733ddf6046")
	)
	(text "Source / changes: Codex custom interface; Molex 467651001 SD-46765-001 sheets 1-2:\nhttps://www.molex.com/content/dam/molex/molex-dot-com/products/automated/en-us/salesdrawingpdf/467/46765/467651001_sd.pdf?inline=\nXEM connector pin list: https://pins.opalkelly.com/pin_list/XEM8310\nJ615: 3/5 MGT_RXP1_226/N (recording in, C755/C756 at MC3); 6/8 B64_L8P/N clock and 9/11 B64_L2P/N command+SYNC,\nLVDS from 1.8 V bank 64 (no GT command: Howard, routing).\n12/14 separate SYNC on B64_L18P/N (LVDS, bank 64; V34 (Howard 7 Nov 2026)). V33 (Howard 6 Nov 2026).\nU806/U814 TI TPD4E02B04 SLVSD85B Rev B secs. 5, 6.6, 8.2, 10: https://www.ti.com/lit/ds/symlink/tpd4e02b04.pdf\nU806 IO1-4 = HDMI 3/5/9/11; U814 (mirrored) IO4/3/2/1 = 6/8/12/14 (12/14 SYNC); flow-through pads tied to their IO\n(SLVSD85B p3); all GND pins to DGND. Direct shell bond assumes a common-ground bench system.\nConnector, cable, SI, ESD layout/strike and enclosure need verification." (exclude_from_sim no) (at 449.04 1121.75 0) (effects (font (size 0.95 0.95)) (justify left top)) (uuid "ee77af5e-a366-4d3e-beec-6f657af3236b"))
	
	(text "Power Jack" (exclude_from_sim no) (at 50.8 196.85 0) (effects (font (size 2.286 2.286) (thickness 0.4572) (bold yes)) (justify left bottom)) (uuid "f0e190ef-fe04-4869-9619-611ed6ba46b7"))
	(text "12 V nominal, center positive" (exclude_from_sim no) (at 61.976 201.93 0) (effects (font (size 2.286 2.286)) (justify bottom)) (uuid "f89b71d5-fb96-4ecd-af7a-20c404bd30c6"))
	(text "Source / changes: Codex circuit using TI TS3A27518E Rev F Fig.5-2, Table 8-1:\nhttps://www.ti.com/lit/ds/symlink/ts3a27518e.pdf\nIN1/IN2 high select NO; active-low EN from rotary; 10k pullup.\nChannels (Howard 1 Nov 2026, for straight PCB routing):\nTCK=4, TDI=6, TMS=3, TDO=5, VREF=2; channel 1 unused.\nNO2-NO6: ±6 kV IEC contact rating; not a 5 V DC clamp.\nSelection, leakage, power-off and SI need checks." (exclude_from_sim no) (at 449.09 795.74 0) (effects (font (size 1.05 1.05)) (justify left top)) (uuid "f9e51c9c-4401-4a27-abfe-51b591ecc879"))
