(version 1)
# Option B LDO Board V3 · Layout V1 (25 Nov 2026)
# Copied from FPGA-LDO A Layout V24 JLCPCB HDI rule set (Stack-up JLCH061611Y1-1078).
# Sources: jlcpcb.com/help/article/hdi-pcb-capabilities-faq, jlcpcb.com/pcb-fabrication/hdi-pcb,
# jlcpcb.com/capabilities/pcb-capabilities; JLC engineering review reply 20 Nov 2026.

(rule "JLC HDI laser via ring 3 mil"
   (condition "A.Via_Type == 'Micro'")
   (constraint annular_width (min 0.0762mm)))

(rule "JLC through and buried via ring"
   (condition "A.Type == 'Via' && A.Via_Type != 'Micro'")
   (constraint annular_width (min 0.1mm)))

(rule "JLC hole to copper 0.2"
   (constraint hole_clearance (min 0.2mm)))

(rule "JLC copper to routed edge 0.2 (board keeps 0.3)"
   (constraint edge_clearance (min 0.3mm)))

(rule "JLC legend to pad 0.15"
   (condition "B.Type == 'Pad'")
   (constraint silk_clearance (min 0.15mm)))

(rule "JLC legend text 1.0 mm high, 0.15 mm stroke"
   (layer "?.Silkscreen")
   (constraint text_height (min 1.0mm))
   (constraint text_thickness (min 0.15mm)))

# Top-side mechanical keep-outs (SYNTHESIS.md §3 & §5):
# Under Router V3 (y 117.634..128.46): ONLY J5 and J6 on F.Cu.
(rule "V3 router top keep-out: only J5/J6 on F.Cu"
   (condition "A.Type == 'Footprint' && A.Layer == 'F.Cu' && A.Reference != 'J5' && A.Reference != 'J6' && A.Reference != 'R4' && A.Reference != 'R23' && A.intersectsArea('ROUTER_KO_TOP')")
   (constraint disallow footprint))

# Under Frontend V14 (y 128.46..153.88): ONLY J1 and J2 on F.Cu (Frontend bottom caps leave ~0.05 mm).
(rule "V3 frontend top keep-out: only J1/J2 on F.Cu"
   (condition "A.Type == 'Footprint' && A.Layer == 'F.Cu' && A.Reference != 'J1' && A.Reference != 'J2' && A.intersectsArea('FRONTEND_KO_TOP')")
   (constraint disallow footprint))
