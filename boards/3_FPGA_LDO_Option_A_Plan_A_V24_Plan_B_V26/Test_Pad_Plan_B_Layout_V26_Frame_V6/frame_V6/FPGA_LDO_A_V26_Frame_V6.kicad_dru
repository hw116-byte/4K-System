(version 1)
# FPGA-LDO A layout V26 in frame V6: the rule set of layouts V12 to V20 (JLCPCB limits as custom rules; values need units).
# Sources (read 10 Nov 2026): jlcpcb.com/help/article/hdi-pcb-capabilities-faq, jlcpcb.com/pcb-fabrication/hdi-pcb,
# jlcpcb.com/capabilities/pcb-capabilities. Stack-up JLCH061611Y1-1078.
(rule "JLC HDI laser via ring 3 mil"
   (condition "A.Via_Type == 'Micro'")
   (constraint annular_width (min 0.0762mm)))
(rule "JLC through and buried via ring"
   (condition "A.Type == 'Via' && A.Via_Type != 'Micro'")
   (constraint annular_width (min 0.1mm)))
(rule "JLC hole to copper 0.2"
   (constraint hole_clearance (min 0.2mm)))
(rule "JLC copper to routed edge 0.2 (board keeps 0.3)"
   (constraint edge_clearance (min 0.3mm)))
(rule "JLC legend to pad 0.15"
   (condition "B.Type == 'Pad'")
   (constraint silk_clearance (min 0.15mm)))
(rule "JLC legend text 1.0 mm high, 0.15 mm stroke"
   (layer "?.Silkscreen")
   (constraint text_height (min 1.0mm))
   (constraint text_thickness (min 0.15mm)))
# Layout V25 (21 Nov 2026): the V21 exception for test-frame edge traces is removed with those traces. Every item keeps 0.3 mm to the board edge.
# Layout V26 (23 Nov 2026), Test Pad Plan B: 15 plated half-hole (castellated) edge test pads TP32-TP46, hole centre on the board outline.
# JLCPCB castellated-hole rules read 23 Nov 2026: jlcpcb.com/blog/castellated-pcbs-introduction-and-design-requirements and
# jlcpcb.com/help/article/what-is-castellated-holes (hole and hole-to-hole gap 0.6 mm or more, 3 mm from a corner, pad 0.5 mm into the board).
# The pads themselves carry KiCad's "castellated" property, so KiCad does not test them against the edge rule.
(rule "V26 half-hole wall to other-net copper 0.25"
   (condition "A.Pad_Type == 'Through-hole' && A.Fabrication_Property == 'Castellated pad'")
   (constraint hole_clearance (min 0.25mm)))
# No exception to the edge rule is added: the four inner-layer connections (TP36, TP39, TP41 on L3, TP44 on L5) start at the hole centre, and KiCad's
# edge test allows a track end that lies inside the hole of a castellated pad. Every other item keeps 0.3 mm to the board edge.
