(symbol (lib_id "FPGA_LDO_V35A:TestPoint") (at 455.93 537.21 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board yes) (dnp no) (uuid "ee0e694a-19a2-564b-8c90-3867e1530af8") (property "Reference" "TP10" (at 457.53 534.81 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "VIN_5V" (at 457.53 536.41 0) (hide yes) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "FPGA_LDO_V35A:TestPoint_Pad_D1.0mm_Compact" (at 455.93 537.21 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "No part: bare copper test pad (footprint TestPoint_Pad_D1.0mm_Compact, project library)" (at 455.93 537.21 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "60de9b23-336f-5ef1-82ca-2d686180f374")) (instances (project "FPGA_LDO_A_Layout_V14" (path "/13d70d08-2de6-58cf-bea9-cfa9d4b587a8" (reference "TP10") (unit 1)))))
(text "TP10: bottom-side pad, silk 5V" (exclude_from_sim no) (at 449 541 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid "ec232fed-81d6-5201-a1d1-c6dcf8c5eb7a"))
(text_box "1. Function: Brings the Frontend's 5 V input (VIN_5V) onto this board on one contact, J1.32, and ends it on the test pad TP10. Nothing on this board uses it: it is a provision, so the regulation can be changed later without a new connector map.\n\n2. Source / changes: Claude design, no manufacturer reference circuit. Howard, 12 Nov 2026 (decision 4 after the meeting with the ASIC designer, 12 Nov 2026 (2026-11-12_FPGA_Work/07_Meeting_With_ASIC_Designer_V1/MEETING_NOTES_V1.md), where the designer suggested also sending 5 V to the LDO board). Contact from pin map V6 (12 Nov 2026; 2026-11-12_FPGA_Work/09_Pin_Map_V6/PIN_MAP_V6.csv and ASIC_PORT_PINS_V6.csv; frozen 13 Nov 2026): J1.32 = VIN_5V with J1.30 (new GND) and J1.34 (GND) as row neighbours, so a solder bridge cannot put 5 V on a 1.5 V line. One DF40 contact is rated 0.3 A (Hirose DF40 catalog, https://datasheet.lcsc.com/datasheet/pdf/145ab5d527b34eafa7a47375cb561c6a.pdf?productCode=C3640153 ). No capacitor: the net has no load here. Layout V13: 0.20 mm on L1 between the two J1 contact rows, 0.29 mm from the inner ends of the 1.5 V contacts 34-68. Unverified: the Frontend does not drive J1.32 yet (its next revision does); the load of any later 5 V use." (exclude_from_sim no) (at 480 524 0) (size 150 37.35) (margins 1.5 1.5 1.5 1.5) (stroke (width 0.3) (type solid)) (fill (type none)) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "ab75bbad-c7b6-5f8f-a928-11977bad1dc5"))
(wire (pts (xy 262.89 55.88) (xy 260.35 55.88)) (stroke (width 0) (type default)) (uuid "1803bb81-d71e-4dfb-b344-60937d631d3b"))
