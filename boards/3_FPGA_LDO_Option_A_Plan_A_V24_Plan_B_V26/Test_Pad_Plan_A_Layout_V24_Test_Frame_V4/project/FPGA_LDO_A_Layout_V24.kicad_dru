(version 1)
# FPGA-LDO A layout V24: the rule set of layouts V12 to V23, unchanged (JLCPCB limits as custom rules; values need units).
# Sources (read 10 Nov 2026): jlcpcb.com/help/article/hdi-pcb-capabilities-faq, jlcpcb.com/pcb-fabrication/hdi-pcb,
# jlcpcb.com/capabilities/pcb-capabilities. Stack-up JLCH061611Y1-1078.
(rule "JLC HDI laser via ring 3 mil"
   (condition "A.Via_Type == 'Micro'")
   (constraint annular_width (min 0.0762mm)))
(rule "JLC through and buried via ring"
   (condition "A.Type == 'Via' && A.Via_Type != 'Micro'")
   (constraint annular_width (min 0.1mm)))
(rule "JLC hole to copper 0.2"
   (constraint hole_clearance (min 0.2mm)))
(rule "JLC copper to routed edge 0.2 (board keeps 0.3)"
   (constraint edge_clearance (min 0.3mm)))
(rule "JLC legend to pad 0.15"
   (condition "B.Type == 'Pad'")
   (constraint silk_clearance (min 0.15mm)))
(rule "JLC legend text 1.0 mm high, 0.15 mm stroke"
   (layer "?.Silkscreen")
   (constraint text_height (min 1.0mm))
   (constraint text_thickness (min 0.15mm)))
# Layout V21 (18 Nov 2026), test frame V1: the only exception to the edge rule above.
# The 15 new edge traces (PCB group TF_EDGE_STUBS_V21, listed in START_HERE / HEADER_PINS.csv) run flush to the board edge,
# so they continue across the break-off tabs of test frame V1. It applies only to tracks that are members of that group AND touch one of the
# rule areas TF_EDGE_SW, TF_EDGE_SE, TF_EDGE_E (0.35 mm strips inside the edge at the three signal tabs). Every other item keeps 0.3 mm.
(rule "V21 test-frame edge traces may reach the board edge"
   (condition "A.Type == 'Track' && A.memberOfGroup('TF_EDGE_STUBS_V21') && (A.intersectsArea('TF_EDGE_SW') || A.intersectsArea('TF_EDGE_SE') || A.intersectsArea('TF_EDGE_E'))")
   (constraint edge_clearance (min 0mm)))
