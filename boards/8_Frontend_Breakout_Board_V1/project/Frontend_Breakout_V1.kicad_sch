		(uuid "662877f1-a38a-51de-b044-0ec6adcff4f3")
	)
	(text "Plug the Frontend (14 layers V17/V18) onto J1/J2 the same way it sits on the FPGA-LDO board; connect the HDMI cable to the Frontend J3 for JTAG and 5 V, or power from J5/J6. Header map: Frontend_Breakout_V1_PINS.csv."
		(exclude_from_sim no)
