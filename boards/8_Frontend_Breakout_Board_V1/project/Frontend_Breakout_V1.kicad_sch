			)
			(justify left top)
		)
		(uuid "332fd5fa-973a-5aff-91e2-ed07b296b4b6")
	)
	(text "FRONTEND BREAKOUT BOARD V1 · every Frontend J1/J2 contact on a 2.54 mm header (pin n = pin n) · 1.5 V FPGA I/O"
		(exclude_from_sim no)
		(at 50.8 50.8 0)
		(effects
			(font
