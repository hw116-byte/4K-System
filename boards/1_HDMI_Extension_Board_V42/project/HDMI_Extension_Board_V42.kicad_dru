(version 1)
# Source: V3/impedance_solver.py on JLC06161H-2116; confirm with JLC before ordering.
(rule "100R pairs on L3"
	(layer "In2.Cu")
	(condition "A.hasNetclass('REC_100R') || A.hasNetclass('CMD_100R')")
	(constraint track_width (min 0.16mm) (opt 0.177mm) (max 0.19mm))
	(constraint diff_pair_gap (min 0.18mm) (opt 0.20mm) (max 0.22mm)))

(rule "PCIe and USB stay on outer layers"
	(layer inner)
	(condition "A.hasNetclass('PCIE_85R') || A.hasNetclass('USB_90R')")
	(constraint disallow track))

# Scoped escape exception, Micro-HDMI only (0.4 mm pitch, 0.23 mm pads). JLC multilayer minimums:
# 0.09 mm track/space class, 0.15/0.25 mm via, via hole to copper 0.20 mm (https://jlcpcb.com/capabilities/pcb-capabilities).
(rule "Micro-HDMI escape inside J61x courtyard"
	(condition "A.intersectsCourtyard('J61*') && B.intersectsCourtyard('J61*')")
	(constraint clearance (min 0.15mm))
	(constraint hole_clearance (min 0.20mm)))

# Hole-to-copper: the board floor is 0.20 mm only because KiCad cannot scope BELOW the board minimum (tested
# 1 Nov 2026: with a 0.25 floor all 30 escape vias fail). The 0.4 mm pitch via-in-pad leaves at most ~0.21 mm
# hole-to-adjacent-pad, so no via fits at 0.25 there. This rule restores 0.25 mm everywhere except item pairs
# that are both inside a J61x courtyard (GT10 / addendum: keep 0.25 mm hole clearance, bounded local exceptions).
(rule "Hole clearance 0.25 mm outside the Micro-HDMI escape"
	(condition "!(A.intersectsCourtyard('J61*') && B.intersectsCourtyard('J61*'))")
	(constraint hole_clearance (min 0.25mm)))

(rule "USB-C fine-pitch pads"
	(condition "A.memberOfFootprint('J500') && B.memberOfFootprint('J500')")
	(constraint clearance (min 0.15mm)))

# V27, 4 Nov 2026 (Howard, following Opal Kelly BRK8310 Rev-AXX): no DGND pour on L1/L6, so the former
# 'L1 L6 DGND pour held off high-speed pairs' rule was removed. Ground pads connect by their own vias to L2/L4/L5.

# USB 90 ohm profile on the outer layers (review of 2 Nov 2026); 0.2 mm is the J500 and D500 fan-out neck.
(rule "USB trace width on outer layers"
	(layer outer)
	(condition "A.hasNetclass('USB_90R')")
	(constraint track_width (min 0.2mm) (opt 0.316mm) (max 0.33mm)))

# J4.1 carries the whole board input; four thermal spokes on 0.5 oz L4 are too thin (independent check of V18).
(rule "J4 power pad solid"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('J4') && A.NetName == '+VDCIN'")
	(constraint zone_connection solid))

# V23, 3 Nov 2026 (Howard: keep the GT recording lanes protected on their own layer). L1 carries the 8 recording
# pairs over solid L2 DGND. Inside the connector/ESD escape (J61x, U80x courtyards) and the MC3 pin field the
# connector pitch sets the spacing, so those items are exempt.
# 0.6 mm keeps every foreign via antipad (via + 0.2 mm) off the L2 return path under the lane edge.
(rule "Recording lanes: foreign vias held off"
	(layer "F.Cu")
	(condition "A.Type == 'Via' && A.NetName != 'DGND' && B.hasNetclass('REC_100R') && !A.intersectsCourtyard('J61*') && !A.intersectsCourtyard('U80*') && !A.memberOfFootprint('MC3')")
	(constraint clearance (min 0.6mm)))
# Other L1 signal tracks and pads stay at least 3W (0.73 mm) from the recording lanes.
(rule "Recording lanes: other L1 copper held off"
	(layer "F.Cu")
	(condition "B.hasNetclass('REC_100R') && !A.hasNetclass('REC_100R') && A.NetName != 'DGND' && A.Type != 'Zone' && A.Type != 'Via' && !A.intersectsCourtyard('J61*') && !A.intersectsCourtyard('U80*') && !A.memberOfFootprint('MC3') && !B.memberOfFootprint('MC3') && !B.intersectsCourtyard('J61*') && !B.intersectsCourtyard('U80*')")
	(constraint clearance (min 0.73mm)))

# V30 (independent V29 review item 2): the J4 input current returns through J4.2; four 0.5 mm thermal spokes on the
# 0.5 oz L2/L5 planes are too thin for the 3.7-5 A case, so J4.2 is solid like J4.1.
(rule "J4 ground pad solid"
	(condition "A.Type == 'Pad' && A.memberOfFootprint('J4') && A.NetName == 'DGND'")
	(constraint zone_connection solid))

# V37 (independent review, 7 Nov 2026): PCIe pin-field necks at the MC3 0.5 mm pitch are 0.33/0.17 mm (85.0 ohm on JLC06161H-2116,
# was 0.28/0.22 = 96.5 ohm). Only the P-to-N gap of the same PCIe pair may go down to 0.165 mm; JLC's 6-layer minimum space is 0.09 mm.
# V38 (re-check): only inside the PCIE_PINFIELD rule area (x 139-154.5, y 104.4-110.85 on L1/L6); elsewhere these pairs keep 0.2 mm.
(rule "PCIe pin-field neck: own-pair gap 0.17 mm"
	(condition "A.intersectsArea('PCIE_PINFIELD') && B.intersectsArea('PCIE_PINFIELD') && ((A.NetName == 'MGT_RXP0_225' && B.NetName == 'MGT_RXN0_225') || (A.NetName == 'MGT_RXN0_225' && B.NetName == 'MGT_RXP0_225') || (A.NetName == 'MGT_RXP1_225' && B.NetName == 'MGT_RXN1_225') || (A.NetName == 'MGT_RXN1_225' && B.NetName == 'MGT_RXP1_225') || (A.NetName == 'MGT_RXP2_225' && B.NetName == 'MGT_RXN2_225') || (A.NetName == 'MGT_RXN2_225' && B.NetName == 'MGT_RXP2_225') || (A.NetName == 'MGT_RXP3_225' && B.NetName == 'MGT_RXN3_225') || (A.NetName == 'MGT_RXN3_225' && B.NetName == 'MGT_RXP3_225') || (A.NetName == 'MGT_TXP0_225' && B.NetName == 'MGT_TXN0_225') || (A.NetName == 'MGT_TXN0_225' && B.NetName == 'MGT_TXP0_225') || (A.NetName == 'MGT_TXP1_225' && B.NetName == 'MGT_TXN1_225') || (A.NetName == 'MGT_TXN1_225' && B.NetName == 'MGT_TXP1_225') || (A.NetName == 'MGT_TXP2_225' && B.NetName == 'MGT_TXN2_225') || (A.NetName == 'MGT_TXN2_225' && B.NetName == 'MGT_TXP2_225') || (A.NetName == 'MGT_TXP3_225' && B.NetName == 'MGT_TXN3_225') || (A.NetName == 'MGT_TXN3_225' && B.NetName == 'MGT_TXP3_225') || (A.NetName == 'MGT_REFCLK1P_225_C' && B.NetName == 'MGT_REFCLK1N_225_C') || (A.NetName == 'MGT_REFCLK1N_225_C' && B.NetName == 'MGT_REFCLK1P_225_C'))")
	(constraint clearance (min 0.165mm)))

# V36 (pre-fab review, 10 Nov 2026): the J920 test holes keep an inner pad only on connected layers, so the planes were pulled back
# only to the 0.25 mm board hole clearance. JLC: inner-layer PTH hole to copper >= 0.30 mm
# (https://jlcpcb.com/capabilities/pcb-capabilities). 0.40 mm here; the ground web between neighbouring holes stays about 0.8 mm.
(rule "J920 test holes: hole to copper 0.40 mm"
	(condition "A.memberOfFootprint('J92*')")
	(constraint hole_clearance (min 0.40mm)))
# V36: unplated M3 standoff holes MH2/MH3 take a metal screw; keep every copper layer 0.50 mm from the hole wall.
(rule "Standoff holes: hole to copper 0.50 mm"
	(condition "A.memberOfFootprint('MH2') || A.memberOfFootprint('MH3')")
	(constraint hole_clearance (min 0.50mm)))
